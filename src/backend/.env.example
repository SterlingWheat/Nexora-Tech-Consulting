# ==========================================
# Configuración de Base de Datos (Neon DB)
# ==========================================
# Reemplazar con las credenciales reales
DB_URL=jdbc:postgresql://<tu-host-neon>.aws.neon.tech:5432/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=tu_password_seguro

# ==========================================
# Configuración de Seguridad JWT
# ==========================================
# Generar una cadena alfanumérica segura de al menos 32 caracteres (256 bits)
JWT_SECRET=tu_secreto_jwt_generado_aleatoriamente_debe_ser_largo
JWT_EXPIRATION=PT24H

# ==========================================
# Configuración CORS (Frontend)
# ==========================================
FRONTEND_ORIGIN=http://localhost:5173